{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paridhwani structured assessment v1",
  "description": "Separate from text-only dialogue v1. Runtime additionally rejects duplicate properties, malformed UTF-8, non-integer version tokens, invalid Unicode, excessive depth and bodies over 65536 bytes, enforces UTF-16-unit caps, resolves content IDs and validates assessment IDs. confidence is heuristic, not a calibrated probability.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/success"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "request_id",
        "quest_id",
        "step_id",
        "learner_text",
        "player"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "quest_id": {
          "type": "string",
          "maxLength": 128,
          "x-maxUtf16CodeUnits": 128,
          "minLength": 1,
          "pattern": "\\S"
        },
        "step_id": {
          "type": "string",
          "maxLength": 128,
          "x-maxUtf16CodeUnits": 128,
          "minLength": 1,
          "pattern": "\\S"
        },
        "learner_text": {
          "type": "string",
          "maxLength": 512,
          "x-maxUtf16CodeUnits": 512,
          "minLength": 1,
          "pattern": "\\S"
        },
        "player": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 80,
              "x-maxUtf16CodeUnits": 80
            }
          }
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "request_id",
        "quest_id",
        "step_id",
        "status",
        "content_revision",
        "assessment"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "quest_id": {
          "type": "string",
          "maxLength": 128,
          "x-maxUtf16CodeUnits": 128,
          "minLength": 1,
          "pattern": "\\S"
        },
        "step_id": {
          "type": "string",
          "maxLength": 128,
          "x-maxUtf16CodeUnits": 128,
          "minLength": 1,
          "pattern": "\\S"
        },
        "status": {
          "const": "ok"
        },
        "content_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome",
            "answer_id",
            "error_category",
            "correction_type",
            "reaction_id",
            "detected_form",
            "confidence"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "accepted",
                "accepted_with_correction",
                "not_accepted"
              ]
            },
            "answer_id": {
              "type": "string",
              "maxLength": 128,
              "x-maxUtf16CodeUnits": 128
            },
            "error_category": {
              "type": "string",
              "maxLength": 128,
              "x-maxUtf16CodeUnits": 128
            },
            "correction_type": {
              "type": "string",
              "maxLength": 128,
              "x-maxUtf16CodeUnits": 128
            },
            "reaction_id": {
              "type": "string",
              "maxLength": 128,
              "x-maxUtf16CodeUnits": 128
            },
            "detected_form": {
              "enum": [
                "kanglish",
                "kannada",
                "english",
                "hindi_roman",
                "mixed",
                "digits",
                "noise"
              ]
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "outcome": {
                    "const": "not_accepted"
                  }
                }
              },
              "then": {
                "properties": {
                  "error_category": {
                    "minLength": 1
                  },
                  "correction_type": {
                    "const": ""
                  }
                }
              },
              "else": {
                "properties": {
                  "answer_id": {
                    "minLength": 1
                  },
                  "error_category": {
                    "const": ""
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "outcome": {
                    "const": "accepted_with_correction"
                  }
                }
              },
              "then": {
                "properties": {
                  "correction_type": {
                    "minLength": 1
                  }
                }
              },
              "else": {
                "properties": {
                  "correction_type": {
                    "const": ""
                  }
                }
              }
            }
          ]
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "request_id",
        "status",
        "error"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "request_id": {
          "type": "string",
          "pattern": "^([0-9a-f]{32})?$"
        },
        "status": {
          "const": "error"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "enum": [
                "invalid_json",
                "invalid_request",
                "unsupported_version",
                "unknown_step",
                "unsupported_step",
                "invalid_assessment",
                "internal_error"
              ]
            }
          }
        }
      }
    }
  }
}
